      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"В ответе есть токен\", () => {\r\n    const body = pm.response.json();\r\n    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;\r\n    // Сохраняем токен, чтобы следующие запросы его использовали\r\n    pm.environment.set(\"token\", body.access_token);\r\n});\r\n\r\npm.test(\"Ответ быстрее 20 секунд\", () => {\r\n    pm.expect(pm.response.responseTime).to.be.below(20000);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"customer@practicesoftwaretesting.com\",\r\n  \"password\": \"welcome01\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Email совпадает с тем, под которым вошли\", () => {\r\n    pm.expect(pm.response.json().email).to.eql(\"customer@practicesoftwaretesting.com\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
