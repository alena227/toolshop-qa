  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Сообщаем серверу, что мы API-клиент и ждём ответ в JSON.\r",
          "// Без этого Laravel при ошибке валидации делает перенаправление (302) вместо 422.\r",
          "pm.request.headers.upsert({ key: \"Accept\", value: \"application/json\" });"
        ],
        "type": "text/javascript"
      }
    }
