          "name": "Brands",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = {\r\n    type: \"array\",\r\n    minItems: 1,\r\n    items: {\r\n        type: \"object\",\r\n        required: [\"id\", \"name\", \"slug\"],\r\n        properties: {\r\n            id: { type: \"string\" },\r\n            name: { type: \"string\", minLength: 1 },\r\n            slug: { type: \"string\", minLength: 1 }\r\n        }\r\n    }\r\n};\r\n\r\npm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Ответ соответствует схеме\", () => {\r\n    pm.response.to.have.jsonSchema(schema);\r\n});\r\n\r\n// Запоминаем id первого бренда — пригодится для фильтра\r\npm.environment.set(\"brandId\", pm.response.json()[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/brands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "brands"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Товары отсортированы по цене по возрастанию\", () => {\r\n    const prices = pm.response.json().data.map(p => p.price);\r\n    const sorted = [...prices].sort((a, b) => a - b);\r\n    pm.expect(prices).to.eql(sorted);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?sort=price,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "price,asc"
                }
              ]
            }
          },
          "response": []
        },
