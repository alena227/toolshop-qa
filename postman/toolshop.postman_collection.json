                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Все товары нужного бренда\", () => {\r\n    const brandId = pm.environment.get(\"brandId\");\r\n    pm.response.json().data.forEach(p => {\r\n        pm.expect(p.brand.id).to.eql(brandId);\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
