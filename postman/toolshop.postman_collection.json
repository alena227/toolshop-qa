                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Поиск что-то нашёл\", () => {\r\n    pm.expect(pm.response.json().data).to.be.an(\"array\").that.is.not.empty;\r\n});\r\n\r\npm.test(\"В каждом названии есть hammer без учёта регистра\", () => {\r\n    pm.response.json().data.forEach(p => {\r\n        pm.expect(p.name.toLowerCase()).to.include(\"hammer\");\r\n    });\r\n});"
                ]
